{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "regions/<region_id>/baseline.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "method_version": {
      "type": "string"
    },
    "is_sample": {
      "type": "boolean"
    },
    "region_id": {
      "type": "string",
      "pattern": "^[A-Z0-9-]+$"
    },
    "build_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "base_period": {
      "type": "object",
      "properties": {
        "start_year": {
          "type": "integer"
        },
        "end_year": {
          "type": "integer"
        }
      },
      "required": [
        "start_year",
        "end_year"
      ],
      "additionalProperties": false
    },
    "months": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "n_years": {
            "type": "integer",
            "minimum": 0
          },
          "mean": {
            "type": [
              "number",
              "null"
            ]
          },
          "std": {
            "type": [
              "number",
              "null"
            ]
          },
          "p10": {
            "type": [
              "number",
              "null"
            ]
          },
          "p25": {
            "type": [
              "number",
              "null"
            ]
          },
          "p50": {
            "type": [
              "number",
              "null"
            ]
          },
          "p75": {
            "type": [
              "number",
              "null"
            ]
          },
          "p90": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "month",
          "n_years",
          "mean",
          "std",
          "p10",
          "p25",
          "p50",
          "p75",
          "p90"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "method_version",
    "is_sample",
    "region_id",
    "build_date",
    "base_period",
    "months"
  ],
  "additionalProperties": false
}